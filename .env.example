# EMS WebApp 5.0 — server configuration (example values only; never commit real ones).
#
# Local development:   copy this file to .env.local (next dev) and/or .dev.vars
#                      (npm run cf:preview). Both files are git-ignored.
# Cloudflare:          Workers & Pages → your worker → Settings → Variables and Secrets.
#                      Add every secret below as type "Secret", not "Text".
# Node.js server:      set them as normal environment variables.
#
# Everything here is read only on the server. Nothing is sent to the browser.

# ── Required ────────────────────────────────────────────────────────────────
# Signs login sessions and password-reset codes. Long and random, e.g.:
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# ── Database: choose ONE provider ───────────────────────────────────────────
# Option A — Supabase (PostgreSQL)
#   SUPABASE_URL: Supabase → Project Settings → Data API → Project URL
#   Key: Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_…).
#   A legacy service_role key (eyJ…) also works until Supabase retires it.
#   This key bypasses Row Level Security: keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias, used when SUPABASE_SERVICE_ROLE_KEY is empty:
# SUPABASE_SECRET_KEY=

# Option B — Cloudflare D1 (SQLite)
#   Not configured here: D1 is a binding named "DB" in wrangler.jsonc
#   (create: npx wrangler d1 create ems-d1; migrate: npm run db:d1:migrate).
#   EMS uses D1 automatically when SUPABASE_URL is empty and the DB binding exists.
#   Set DB_DRIVER=d1 to force D1 even if Supabase variables are present.
# DB_DRIVER=d1

# Files (Vaultium, App Store uploads) use the R2 binding "FILES" in wrangler.jsonc.

# ── Recommended ─────────────────────────────────────────────────────────────
# Public address of the site, used in QR verification links, emails and the sitemap.
# SITE_URL=https://ems.example.com

# Brevo (https://www.brevo.com) transactional email. Needed for password-reset
# codes and shop emails. The sender address is set in the owner console
# (ConnectX) and must be a verified sender in Brevo.
BREVO_API_KEY=

# ── Optional: AI providers for Zudo AI / Business Health ─────────────────────
# Only the providers you select in the owner console need a key. "@cf/…" models
# use the Workers AI binding instead (no key).
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# ANTHROPIC_API_KEY=

# ── Development only: never set these in production ─────────────────────────
# MOCK_EMAIL=1   pretend emails were sent (password-reset codes are NOT delivered)
# MOCK_AI=1      canned AI answers
