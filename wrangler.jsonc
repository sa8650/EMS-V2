{
  // EMS 5 — Cloudflare Worker settings (used automatically when Cloudflare builds the site).
  // Setup guide: docs/DEPLOYMENT.md. The Worker in the Cloudflare dashboard must be named "ems-app".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ems-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ems-app" }],
  "observability": { "enabled": true },
  // Keep settings added in the Cloudflare dashboard when a new version is deployed.
  "keep_vars": true,

  // Workers AI (Zudo AI / Business Health with "@cf/…" models). Nothing to set up.
  "ai": { "binding": "AI" },

  // OPTIONAL — file storage (Vaultium documents, App Store uploads).
  // First create an R2 bucket named ems-files in the Cloudflare dashboard,
  // then remove the two slashes (//) at the start of the next line.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "ems-files" }],

  // OPTIONAL — Cloudflare D1 database (instead of Supabase). See docs/DATABASE.md.
  // Remove the two slashes (//) at the start of each of the next 8 lines,
  // and replace PASTE-YOUR-D1-DATABASE-ID with the Database ID shown in Cloudflare.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ems-d1",
      "database_id": "4e8a0693-59f8-4031-b65b-267b625af327",
      "migrations_dir": "db/d1/migrations"
    }
  ],
}
